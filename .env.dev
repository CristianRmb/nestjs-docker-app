DB_USER=postgres
DB_PASS=postgres
DB_NAME=myapp
NODE_ENV=dev
PORT=3000

# queto vale se si fa partire il server con il comando `npm run start:dev` (ovviamente bisogna avere il DB docker in esecuzione)
# DB_HOST=localhost
# DB_PORT=5431
# DATABASE_URL="postgresql://postgres:postgres@localhost:5431/myapp?schema=public"

# se si usa docker:
DB_HOST=db
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@db:5432/myapp?schema=public"
